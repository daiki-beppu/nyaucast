{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "bin/nyaucast.js",
    "src/index.ts",
    "test/helpers.ts",
    "test/package-smoke-support.ts",
    "test/fixtures/package-dependency-probe.ts"
  ],
  "ignorePatterns": [
    "bin/**/*.test.ts",
    "test/**/*.test.ts",
    "*.config.ts",
    "prototype/**",
    "scripts/**"
  ],
  "ignoreDependencies": ["yaml"],
  "duplicates": {
    "enabled": true,
    "mode": "semantic",
    "minTokens": 50,
    "minLines": 1,
    "minOccurrences": 2,
    "threshold": 50,
    "ignore": [
      "src/db/schema.ts",
      "src/db/gates.ts",
      "src/channel/channel-settings.ts",
      "src/tools/explainer.writePlan.ts",
      "src/tools/plan.init.ts",
      "src/tools/video.status.ts",
      "test/helpers.ts",
      "test/package-smoke-support.ts",
      "test/fixtures/**"
    ]
  },
  "health": {
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "ignore": ["test/package-smoke-support.ts", "test/fixtures/**"]
  }
}
