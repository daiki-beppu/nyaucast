{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "bin/nyaucast.js",
    "src/index.ts",
    "test/helpers.ts",
    "test/package-smoke-support.ts",
    "test/codec-support.ts",
    "test/fixtures/package-dependency-probe.ts"
  ],
  "ignorePatterns": [
    "bin/**/*.test.ts",
    "test/**/*.test.ts",
    "*.config.ts",
    "prototype/**",
    "scripts/**"
  ],
  "ignoreDependencies": ["yaml"],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "unused-dependency-overrides": "error",
    "boundary-violation": "error"
  },
  "duplicates": {
    "enabled": true,
    "mode": "weak",
    "near": true,
    "minTokens": 45,
    "minLines": 1,
    "minOccurrences": 2,
    "threshold": 0.01,
    "ignore": ["test/helpers.ts", "test/package-smoke-support.ts", "test/fixtures/**"]
  },
  "health": {
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "suggestInlineSuppression": false,
    "ignore": ["test/package-smoke-support.ts", "test/fixtures/**"]
  },
  "boundaries": {
    "zones": [
      {
        "name": "chrome",
        "patterns": ["src/lib/chrome.ts", "src/lib/cdp.ts", "src/lib/chrome-pin.ts"]
      },
      {
        "name": "chrome-users",
        "patterns": [
          "src/tools/explainer/video.renderCut.ts",
          "src/tools/explainer/video.previewCut.ts",
          "src/compositions/capture.ts"
        ]
      },
      {
        "name": "wiring",
        "patterns": ["src/index.ts", "src/mcp.ts"]
      },
      {
        "name": "core",
        "patterns": ["src/**"]
      }
    ],
    "rules": [
      {
        "from": "chrome",
        "allow": ["core"]
      },
      {
        "from": "chrome-users",
        "allow": ["core", "chrome"]
      },
      {
        "from": "wiring",
        "allow": ["core", "chrome-users", "chrome"]
      },
      {
        "from": "core",
        "allow": ["core", "chrome-users"]
      }
    ]
  }
}
