{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["actionable", "awaiting", "clean"],
      "description": "actionable=対応すべき指摘がある / awaiting=レビューが進行中で結論待ち / clean=未対応の指摘なし"
    },
    "pr_number": {
      "type": "integer",
      "description": "確認対象の PR 番号"
    },
    "actionable": {
      "type": "array",
      "description": "対応すると判断した指摘",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "指摘元（CodeRabbit / レビュアーのログイン名 / GitHub Actions 等）"
          },
          "location": {
            "type": "string",
            "description": "指摘箇所の file:line。PR 全体への指摘なら空文字"
          },
          "issue": { "type": "string", "description": "指摘の内容" },
          "severity": {
            "type": "string",
            "enum": ["blocking", "should", "nit"],
            "description": "blocking=マージを止める / should=直すべき / nit=軽微"
          }
        },
        "required": ["source", "location", "issue", "severity"],
        "additionalProperties": false
      }
    },
    "dismissed": {
      "type": "array",
      "description": "対応しないと判断した指摘。理由の記載は必須",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "location": { "type": "string" },
          "issue": { "type": "string" },
          "reason": {
            "type": "string",
            "description": "対応しない理由。ADR / 仕様 / 事実誤認の根拠を示す"
          }
        },
        "required": ["source", "location", "issue", "reason"],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "description": "1-2 文の状況要約"
    }
  },
  "required": ["status", "pr_number", "actionable", "dismissed", "summary"],
  "additionalProperties": false
}
