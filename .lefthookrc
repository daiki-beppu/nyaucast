# git hook は呼び出し元シェルの環境を継承するため、devShell だけが供給する
# ツール（lefthook / nixfmt / node_modules/.bin）は direnv を通さない呼び出し元
# （非対話シェル・GUI クライアント）では PATH に無い。lefthook shim の
# /nix/store 絶対パス焼き込みも nixpkgs 更新 / GC で失効し得る（#334）。
# そこで hook 自身が worktree の devShell 環境を自給する。

# direnv とその評価に要る nix 本体は well-known な nix-darwin プロファイルに
# あるが、GUI クライアント等の最小 PATH には含まれないため先に補う。
for nix_profile_bin in \
  "/etc/profiles/per-user/$(id -un)/bin" \
  /run/current-system/sw/bin \
  /nix/var/nix/profiles/default/bin; do
  if [ -d "$nix_profile_bin" ]; then
    case ":$PATH:" in
      *":$nix_profile_bin:"*) ;;
      *) PATH="$PATH:$nix_profile_bin" ;;
    esac
  fi
done
unset nix_profile_bin
export PATH

# direnv 不在・worktree 未 allow なら何もせず、従来どおりの失敗に倒れる。
# 呼び出し元で devShell が読み込み済みなら direnv export は再評価せず即返る。
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv export bash 2>/dev/null)" || true
fi
