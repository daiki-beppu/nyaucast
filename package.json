{
  "name": "@daiki-beppu/tayk",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "bin": {
    "tayk": "bin/tayk.js"
  },
  "files": [
    "bin/tayk.js",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "check": "bun run lockfile:check && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run fallow",
    "lockfile:check": "bun install --frozen-lockfile --dry-run --ignore-scripts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts --type-aware --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --config oxlint.config.ts --type-aware --no-error-on-unmatched-pattern --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "bun test",
    "fallow": "fallow --no-cache --fail-on-issues"
  },
  "devDependencies": {
    "@mediabunny/server": "1.51.0",
    "@puppeteer/browsers": "^3.0.6",
    "@types/bun": "1.3.14",
    "@types/pngjs": "^6.0.5",
    "devtools-protocol": "^0.0.1670834",
    "fallow": "3.9.1",
    "gsap": "^3.15.0",
    "lefthook": "2.1.10",
    "mediabunny": "1.51.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "trustedDependencies": [
    "node-av"
  ]
}
