{
  "name": "@daiki-beppu/tayk",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/daiki-beppu/tayk.git"
  },
  "bin": {
    "tayk": "bin/tayk.js"
  },
  "files": [
    "bin/tayk.js",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run lockfile:check && vp check && pnpm run actions:check && vp test run && pnpm run fallow",
    "lockfile:check": "pnpm install --frozen-lockfile --lockfile-only",
    "actions:check": "github-actionlint",
    "fallow": "fallow --no-cache --fail-on-issues",
    "prepare": "vp hooks enable"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fallow": "3.18.0",
    "github-actionlint": "1.7.12",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "yaml": "2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.24.0"
}
