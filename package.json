{
  "name": "@daiki-beppu/tayk",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/daiki-beppu/tayk.git"
  },
  "bin": {
    "tayk": "bin/tayk.js"
  },
  "files": [
    "bin/tayk.js",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run lockfile:check && bun run typecheck && bun run lint && bun run actions:check && bun run format:check && bun run format:nix:check && bun run test && bun run fallow",
    "lockfile:check": "bun install --frozen-lockfile --dry-run --ignore-scripts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts --type-aware --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --config oxlint.config.ts --type-aware --no-error-on-unmatched-pattern --fix .",
    "actions:check": "actionlint",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "format:nix:check": "nixfmt --check $(git ls-files '*.nix')",
    "format:nix:fix": "nixfmt $(git ls-files '*.nix')",
    "test": "bun test",
    "fallow": "fallow --no-cache --fail-on-issues"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "ajv": "6.15.0",
    "fallow": "3.14.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
