{
  "name": "nyaucast",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/daiki-beppu/nyaucast.git"
  },
  "bin": {
    "nyaucast": "bin/nyaucast.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "imports": {
    "#nyaucast-entry": {
      "nyaucast-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run lockfile:check && vp check && pnpm run effect:check && pnpm run actions:check && vp test run && pnpm run fallow",
    "lockfile:check": "pnpm install --frozen-lockfile --lockfile-only",
    "actions:check": "github-actionlint",
    "fallow": "fallow --no-cache --fail-on-issues",
    "mutation": "pnpm exec stryker run",
    "prepack": "tsc --project tsconfig.build.json",
    "prepare": "vp hooks enable",
    "effect:check": "effect-tsgo diagnostics --project tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-libsql": "4.0.0",
    "effect": "4.0.0",
    "google-auth-library": "11.0.2",
    "oauth-callback": "2.2.0",
    "open": "11.0.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "4.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "fallow": "3.18.0",
    "github-actionlint": "1.7.12",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0",
    "yaml": "2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.2.1"
}
