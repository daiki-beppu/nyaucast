{
  "name": "nyacast",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/daiki-beppu/nyacast.git"
  },
  "bin": {
    "nyacast": "bin/nyacast.js"
  },
  "files": [
    "dist",
    "bin",
    "drizzle"
  ],
  "type": "module",
  "imports": {
    "#nyacast-entry": {
      "nyacast-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run lockfile:check && vp check && pnpm run actions:check && vp test run && pnpm run fallow",
    "lockfile:check": "pnpm install --frozen-lockfile --lockfile-only",
    "actions:check": "github-actionlint",
    "fallow": "fallow --no-cache --fail-on-issues",
    "mutation": "pnpm exec stryker run",
    "db:generate": "drizzle-kit generate",
    "prepack": "tsc --project tsconfig.build.json",
    "prepare": "vp hooks enable"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.0.2",
    "oauth-callback": "2.2.0",
    "open": "11.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "fallow": "3.18.0",
    "github-actionlint": "1.7.12",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "yaml": "2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.2.1"
}
