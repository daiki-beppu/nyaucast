{
  "name": "nyaucast",
  "version": "0.0.2",
  "description": "YouTube channel operations toolkit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/daiki-beppu/nyaucast.git"
  },
  "bin": {
    "nyaucast": "bin/nyaucast.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "NOTICE"
  ],
  "type": "module",
  "imports": {
    "#nyaucast-entry": {
      "nyaucast-source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm run lockfile:check && pnpm run '/^(vp|effect|actions):check$/' && vp test run ${VITEST_SHARD:+--shard=$VITEST_SHARD} && pnpm run fallow",
    "lockfile:check": "pnpm install --frozen-lockfile --lockfile-only",
    "vp:check": "vp check",
    "actions:check": "github-actionlint",
    "fallow": "fallow --no-cache --fail-on-issues",
    "mutation": "pnpm exec stryker run",
    "prepack": "tsc --project tsconfig.build.json",
    "prepare": "vp hooks enable",
    "effect:check": "effect-tsgo diagnostics --project tsconfig.json",
    "shard-weights:update": "vp test run --reporter=json --outputFile=node_modules/.cache/nyaucast/test-report.json && node scripts/update-shard-weights.ts node_modules/.cache/nyaucast/test-report.json"
  },
  "dependencies": {
    "@audio/loudness-lufs": "1.2.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-libsql": "4.0.0",
    "@mediabunny/server": "1.61.0",
    "@puppeteer/browsers": "3.2.3",
    "alchemy": "2.0.0-beta.81",
    "cf": "1.0.0-beta.12",
    "effect": "4.0.0",
    "fast-xml-parser": "5.11.2",
    "google-auth-library": "11.0.2",
    "mediabunny": "1.61.0",
    "oauth-callback": "2.2.0",
    "open": "11.0.2",
    "sharp": "0.35.5",
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "4.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "@types/twitter-text": "3.1.10",
    "fallow": "3.18.0",
    "github-actionlint": "1.7.12",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0",
    "yaml": "2.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.11.2"
}
