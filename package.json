{
  "name": "@daiki-beppu/tayk",
  "version": "0.0.0",
  "description": "YouTube channel operations toolkit",
  "bin": {
    "tayk": "bin/tayk.js"
  },
  "files": [
    "bin/tayk.js",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts --type-aware --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --config oxlint.config.ts --no-error-on-unmatched-pattern --fix",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write",
    "test": "bun test",
    "fallow": "fallow --no-cache --fail-on-issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "fallow": "3.9.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
